# Resolve the complete human-facing dependency declaration, then constrain its
# direct dependencies to the versions exercised by the macOS Python 3.11 job.
-r requirements.txt

# Embedding provenance is an index-compatibility requirement. The pinned
# essentia-tensorflow 2.1b6.dev1389 wheel bundles TensorFlow 2.19.0, matching
# the runtime that produced the existing 2560-dimensional user index, and it
# imports cleanly with NumPy 2.2.6. Inspection of every bundled native binary
# found a real maximum LC_BUILD_VERSION minos of macOS 15.2. The app spec still
# declares LSMinimumSystemVersion 10.13, which is false under this dependency
# set; correcting that bundle metadata is intentionally out of scope here.
numpy==2.2.6
pandas==2.3.2
pyarrow==21.0.0
lxml==6.1.2
pywebview==6.2.1
typer==0.27.1

# Build/audio/UI dependencies. These capture what the previously unpinned
# build resolved on 2026-08-20 instead of speculating about older releases.
soundfile==0.14.0
essentia-tensorflow==2.1b6.dev1389
pyobjc-framework-Cocoa==12.2.2
pyinstaller==6.22.2

# The lock is shared by build and test; the PyInstaller spec excludes pytest
# from the app bundle explicitly.
pytest==9.1.1
